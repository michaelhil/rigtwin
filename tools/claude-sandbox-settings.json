{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Decision 5, prepared and not active: settings for a Claude Code session that works against the public sandbox (claude --settings tools/claude-sandbox-settings.json). The permission deny list below is a guard rail against mistakes, not a sandbox: a shell has many ways round prefix rules. The barrier is Claude Code's own sandbox (the 'sandbox' block): commands may write only inside the project and reach only mightwork.ai, and cannot read private/ or ~/.ssh. Text that comes back from the public server is written by strangers; bun run rig marks group names from it as untrusted_group.",
  "env": {
    "RIG_URL": "https://mightwork.ai/rigtwin"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": ["mightwork.ai"]
    },
    "filesystem": {
      "denyRead": ["./private", "~/.ssh", "~/.aws", "~/.config/gh", "~/.gnupg"],
      "denyWrite": ["./deploy", "./.github", "./tools", "./server", "./shared", "./viewer", "./assets", "./wiki", "./.claude"]
    }
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(bun run rig:*)",
      "Bash(bun tools/rig.ts:*)"
    ],
    "deny": [
      "Read(./private/**)",
      "Read(~/.ssh/**)",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "Bash(git push:*)",
      "Bash(git -C:*)",
      "Bash(git remote:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(env:*)",
      "Bash(/usr/bin/ssh:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(zsh -c:*)",
      "Bash(eval:*)",
      "Bash(bun -e:*)",
      "Bash(bun --eval:*)",
      "Bash(node -e:*)",
      "Bash(python3 -c:*)",
      "Bash(curl:*)",
      "Bash(bun run deploy:*)",
      "Bash(bun tools/deploy.ts:*)",
      "Bash(bun run dist:*)",
      "Bash(bash deploy/setup-server.sh:*)",
      "Bash(deploy/setup-server.sh:*)"
    ]
  }
}
