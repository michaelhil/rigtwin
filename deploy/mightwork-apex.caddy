# Caddy site for the bare domain mightwork.ai: nothing is served from it any more.
# Installed on the production host as /etc/caddy/managed-sites/mightwork-apex.caddy (the main Caddyfile imports
# /etc/caddy/managed-sites/*.caddy) by `deploy/setup-server.sh --retire-apex`, once Synergon is live at
# https://synergon.mightwork.ai/. Every address on mightwork.ai answers 404: no route is left. The block keeps the
# domain's certificate and its security headers, so a visitor sees a clean 404 over HTTPS and not a certificate error.
# (The alternative, removing this file, would leave the name without any site: Caddy would then not answer it at all.)
#
# Synergon itself is at deploy/synergon.caddy. Other sites on the host have their own files and are not affected.

mightwork.ai {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	respond "Not found" 404
}
